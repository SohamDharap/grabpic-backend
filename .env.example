# =====================================================
# GrabPic Backend - Production Environment Variables (.env)
# =====================================================
# Copy this file to .env on your GCP Compute Engine VM.
# DO NOT commit the actual .env file with secrets to Git.

# =====================================================
# 1. JWT Security Configuration
# =====================================================
# Cryptographically secure random secret (at least 32+ characters / 256 bits)
APP_JWT_SECRET=replace-with-a-strong-32+-character-secret-key
APP_JWT_EXPIRATION_MS=86400000

# =====================================================
# 2. Database Configuration (PostgreSQL + pgvector)
# =====================================================
# For Docker Compose: jdbc:postgresql://postgres:5432/grabpic_db
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/grabpic_db
SPRING_DATASOURCE_USERNAME=grabpic_user
SPRING_DATASOURCE_PASSWORD=your-secure-db-password
DDL_AUTO=validate
SHOW_SQL=false

# =====================================================
# 3. Google Cloud Storage (GCS) Configuration
# =====================================================
# Active storage provider: 'gcs' for production, 'local' for local development
STORAGE_PROVIDER=gcs

# GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# GCS Bucket Name (Private bucket)
GCS_BUCKET_NAME=grabpic-media
GCS_BUCKET_LOCATION=asia-south1

# Authentication Mode: 'adc' uses Application Default Credentials from GCE VM
# Never provide or mount a JSON service account key.
GCS_AUTH_MODE=adc

# GCS Object Naming Prefix
GCS_OBJECT_PREFIX=events
GCS_ORIGINAL_DIRECTORY=original
GCS_THUMBNAIL_DIRECTORY=thumbnail

# V4 Signed URL Configuration (Time-limited access for private bucket)
GCS_SIGNED_URL_ENABLED=true
GCS_SIGNED_URL_DURATION_MINUTES=15
GCS_SIGNED_URL_MAX_DURATION_MINUTES=60
GCS_SIGNING_SERVICE_ACCOUNT=529807292953-compute@developer.gserviceaccount.com

# Storage Behavior Flags
STORAGE_DELETE_ON_UPLOAD_FAILURE=true
STORAGE_SIGN_THUMBNAILS=true
STORAGE_SIGN_ORIGINAL_ON_DEMAND=true
STORAGE_SIGN_UPLOAD_RESPONSES=true

# =====================================================
# 4. Image Processing & Thumbnail Settings
# =====================================================
IMAGE_THUMBNAIL_ENABLED=true
IMAGE_THUMBNAIL_WIDTH=400
IMAGE_THUMBNAIL_HEIGHT=400
IMAGE_THUMBNAIL_QUALITY=0.80
IMAGE_THUMBNAIL_FORMAT=jpeg
IMAGE_THUMBNAIL_PRESERVE_ASPECT_RATIO=true

# =====================================================
# 5. Upload Limits & Ephemeral Processing
# =====================================================
APP_UPLOAD_MAX_FILES=50
APP_UPLOAD_MAX_ZIP_SIZE_MB=500
APP_UPLOAD_MAX_IMAGE_SIZE_MB=25
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=500MB
# Ephemeral ZIP extraction directory (defaults to system /tmp)
# APP_UPLOAD_ZIP_TEMP_DIR=/tmp

# =====================================================
# 6. AI Python Face Embedding Service (InsightFace)
# =====================================================
# Internal Docker DNS: http://face-service:8001
PYTHON_FACE_SERVICE_BASE_URL=http://face-service:8001
PYTHON_FACE_SERVICE_EMBED_PATH=/embed
PYTHON_FACE_SERVICE_CONNECT_TIMEOUT_MS=5000
PYTHON_FACE_SERVICE_READ_TIMEOUT_MS=120000

# =====================================================
# 7. SMTP Email Configuration (Gmail / Corporate SMTP)
# =====================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-prod-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_NAME=GrabPic Admin

# =====================================================
# 8. OTP Configuration
# =====================================================
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_HARDCODED_ENABLED=false
OTP_HARDCODED_VALUE=123456

# =====================================================
# 9. Docker Hub Configuration
# =====================================================
DOCKER_USERNAME=sohamdharap
IMAGE_TAG=latest
FACE_SERVICE_TAG=latest

# =====================================================
# 10. Logging Levels
# =====================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_APP=INFO
